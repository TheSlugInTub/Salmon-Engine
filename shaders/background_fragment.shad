#version 330 core
out vec4 FragColor;

in vec2 TexCoord;
in vec3 FragPos;
in mat4 ViewMatrix;

uniform sampler2D texture1;          // Background texture
uniform sampler2D spritePass;        // Rendered sprites pass texture
uniform sampler2D depthTexture;      // Depth map
uniform sampler2D paletteTexture;    // Pallete to fill colours with

uniform mat4 spriteProjectionMatrix; // Projection matrix used for sprite pass rendering

uniform vec2 texture1Size = vec2(400.0, 300.0);
uniform vec2 spritePassSize = vec2(1920.0, 1080.0);
uniform float shadowIntensity = 0.2;
uniform vec2 shadowOffset = vec2(0.1, 0.1); // World-space offset for shadow
uniform float depthScale = 1.0;     // Scale factor for depth-based offset

vec4 MapColor(vec4 backgroundColor) 
{
    float rgbCol = floor(backgroundColor.x * 255.0);
    
    if (rgbCol < 80.0 && rgbCol > 1.0)
    {  
        float colorIndex = floor(rgbCol / 5.0);
        return texelFetch(paletteTexture, ivec2(colorIndex, 14), 0);
    }
    
    return backgroundColor;
}

void main()
{
    float depthPixel = texture(depthTexture, TexCoord).x;
 
    // Scale shadow offset based on quantized depth
    vec2 scaledOffset = shadowOffset * (1.0 + depthPixel * depthScale);
    
    // Apply scaled world-space shadow offset
    vec3 shadowWorldPos = FragPos + vec3(scaledOffset.x, scaledOffset.y, 0.0);
    
    // Transform to sprite pass clip space
    vec4 clipPos = spriteProjectionMatrix * ViewMatrix * vec4(shadowWorldPos, 1.0);
    vec3 ndc = clipPos.xyz / clipPos.w;
    
    // Convert NDC to UV coordinates
    vec2 spriteUV = ndc.xy * 0.5 + 0.5;
    
    // Check if UV is within texture bounds
    if (spriteUV.x < 0.0 || spriteUV.x > 1.0 || spriteUV.y < 0.0 || spriteUV.y > 1.0) {
        FragColor = MapColor(texture(texture1, TexCoord));
        return;
    }
    
    // Sample sprite pass and background
    vec4 spriteColor = texture(spritePass, spriteUV);
    vec4 backgroundColor = MapColor(texture(texture1, TexCoord));
    
    // Determine if sprite is present
    float spritePresent = step(0.01, dot(spriteColor.rgb, vec3(1.0)));
    
    // Apply shadow if sprite is present, with depth-based intensity
    float depthBasedIntensity = shadowIntensity * (1.0 - depthPixel * 0.5);
    vec4 finalColor = mix(backgroundColor, vec4(0.0), depthBasedIntensity * spritePresent);
    FragColor = finalColor;
}
