#version 330 core
out vec4 FragColor;

in vec2 TexCoord;
in vec3 FragPos;

uniform sampler2D texture1;      // Background texture
uniform sampler2D spritePass;    // Rendered sprites pass texture
uniform sampler2D depthTexture;  // Depth information textur

uniform vec2 texture1Size = vec2(400.0, 300.0);       // Size of background texture (width, height)
uniform vec2 spritePassSize = vec2(1920.0, 1080.0);     // Size of sprite pass texture (width, height)
uniform float shadowIntensity = 0.5;    // How dark the shadows appear
uniform vec2 shadowOffset = vec2(0.1, 0.1); // Shadow offset in screen UV space

void main()
{
    // Get the texel size for both textures
    vec2 texel1Size = 1.0 / texture1Size;
    vec2 spriteTexelSize = 1.0 / spritePassSize;
    
    // Calculate the equivalent position in the sprite pass texture
    vec2 spriteUV = TexCoord * (texture1Size / spritePassSize);
    
    // Apply shadow offset in pixel-space (scaled by texture size ratio)
    vec2 shadowCoord = TexCoord + (shadowOffset * (texture1Size / spritePassSize));
    
    // Sample the textures
    vec4 backgroundColor = texture(texture1, shadowCoord);
    vec4 spriteColor = texture(spritePass, spriteUV);
    
    // Check if there's a sprite at this position (anything not black)
    float spritePresent = step(0.01, dot(spriteColor.rgb, vec3(1.0)));
    
    // Apply shadow if sprite is present
    vec4 finalColor = backgroundColor;
    if(spritePresent > 0.0) {
        finalColor = mix(backgroundColor, vec4(0.0, 0.0, 0.0, 1.0), shadowIntensity);
    }
    
    FragColor = finalColor;
}
